#!/bin/busybox sh
# Testovací initramfs pro první boot mainline kernelu na troice.
# Nic nezapisuje na úložiště; jen vypíše stav na konzoli a čeká na tlačítka.

/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs dev /dev 2>/dev/null

# Pis primo na displej. Kdyz bootloader preda "console=null" (jako u
# puvodniho systemu), /dev/console nikam nevede a nebylo by nic videt.
[ -c /dev/tty0 ] && exec > /dev/tty0 2>&1 < /dev/tty0

# Vypiš jen chyby kernelu, ať se výstup testu nepřepisuje.
echo 3 > /proc/sys/kernel/printk

echo
echo "=================================================="
echo " TROIKA MAINLINE TEST - initramfs bezi"
echo "=================================================="
echo "kernel:  $(uname -r)"
echo "model:   $(cat /proc/device-tree/model 2>/dev/null | tr -d '\0')"
echo "soc_id:  $(cat /sys/devices/soc0/soc_id 2>/dev/null)  rev $(cat /sys/devices/soc0/revision 2>/dev/null)"
echo "cpu:     $(grep -c ^processor /proc/cpuinfo) online"
echo "$(grep MemTotal /proc/meminfo)"
echo "fb:      $(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null) $(cat /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null) bpp"
# Cela prikazova radka ma pres 1000 znaku a je v ni seriove cislo a MAC adresy;
# staci zacatek a nase znacka testu.
echo "cmdline: $(cut -c1-120 /proc/cmdline)..."
test_tag=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^pmos_test=//p')
echo "test:    $test_tag"
echo
echo "Barevny test (ma byt CERVENA ZELENA MODRA):"
printf '\033[41m   CERVENA   \033[42m   ZELENA   \033[44m   MODRA   \033[0m\n'
echo
# Hodiny: jen kdyz kernel ma ovladac CMU (vetev troika-clk). Pocet hodin,
# sirotci (hodiny bez dohledatelneho rodice), vybrane frekvence a ladici
# radky kernelu "CLKDBG" (registry option a stav napajecich domen).
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
s=/sys/kernel/debug/clk/clk_summary
o=/sys/kernel/debug/clk/clk_orphan_summary
if [ "$(awk 'NR > 3 && NF > 4' $s 2>/dev/null | wc -l)" -gt 1 ]; then
	echo "--- HODINY ---"
	echo "hodin: $(awk 'NR > 3 && NF > 4' $s | wc -l)  sirotku: $(awk 'NR > 3 && NF > 4' $o | wc -l)"
	awk 'NR > 3 && NF > 4 { printf "%s ", $1 }' $o | cut -c1-200
	echo
fi
# Podrobnosti o hodinach jen v testech hodin (pmos_test=clk...), jinak se
# vysledek testu nevejde na displej.
if [ -r $s ] && [ "${test_tag#clk}" != "$test_tag" ]; then
	for c in fout_shared0_pll fout_shared1_pll fout_mmc_pll fout_cpucl0_pll \
		fout_aud_pll dout_cmu_fsys_bus dout_cmu_fsys_ufs_embd \
		gout_fsys_ufs_embd_clk_unipro dout_cmu_fsys_mmc_card dout_cmu_usb_bus \
		dout_cmu_usb_usb30drd dout_cmu_peri_uart dout_cmu_dispaud_disp; do
		awk -v c="$c" '$1 == c { printf " %-30s %s\n", $1, $5 }' $s
	done
	dmesg | sed -n 's/^.*CLKDBG //p'
	echo
fi

# UFS: nic se nepripojuje a nic se nezapisuje. Kazdy disk se hned po nalezeni
# prepne na "jen pro cteni" (plati i pro jeho oddily). Hledani disku bezi
# v kernelu na pozadi, proto se na ne chvili ceka.
ufs_host=$(ls -d /sys/bus/platform/drivers/exynos-ufshc/*.ufs 2>/dev/null | head -n 1)
if [ -n "$ufs_host" ] || [ "${test_tag#ufs}" != "$test_tag" ]; then
	echo "--- UFS ---"
	i=0
	while [ $i -lt 15 ] && ! ls /sys/block/sd* > /dev/null 2>&1; do
		sleep 1
		i=$((i + 1))
	done
	[ $i -gt 0 ] && sleep 2
	for d in /sys/block/sd*; do
		[ -e "$d" ] || continue
		n=${d##*/}
		blockdev --setro /dev/$n
		echo "$n: $(cat $d/device/vendor) $(cat $d/device/model) $(($(cat $d/size) / 2048)) MiB ro=$(cat $d/ro) oddilu=$(ls -d $d/$n[0-9]* 2> /dev/null | wc -l)"
	done
	if ! ls /sys/block/sd* > /dev/null 2>&1; then
		echo "!! Zadny disk. Ovladac: ${ufs_host:-nenavazan}"
	fi
	# Hlasky ovladace jen v testech UFS, jinak zabiraji misto na displeji.
	[ "${test_tag#ufs}" != "$test_tag" ] &&
		dmesg | grep -E "ufshc|ufs-phy|ufshcd|scsi " | grep -v UFSDBG | tail -n 7 | cut -c1-110
	echo
fi

# USB: kdyz kernel nabidne radic (UDC), zapni sitovy gadget NCM se stejnymi ID
# jako initramfs pmOS, nastav adresu 172.16.42.1 a spust DHCP a telnet
# (binarky z initramfs pmOS, pokud jsou pribalene).
udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
if [ -n "$udc" ]; then
	echo "--- USB ---"
	# Ladici radky USB jen v testech USB, jinak zabiraji misto na displeji.
	[ "${test_tag#usb}" != "$test_tag" ] && dmesg | sed -n 's/^.*USBDBG //p'
	mount -t configfs configfs /sys/kernel/config
	g=/sys/kernel/config/usb_gadget/g1
	mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 $g/functions/ncm.usb0
	echo 0x18d1 > $g/idVendor
	echo 0xd001 > $g/idProduct
	echo Motorola > $g/strings/0x409/manufacturer
	echo "troika mainline test" > $g/strings/0x409/product
	echo troika > $g/strings/0x409/serialnumber
	echo NCM > $g/configs/c.1/strings/0x409/configuration
	ln -s $g/functions/ncm.usb0 $g/configs/c.1/
	if echo "$udc" > $g/UDC; then
		echo "gadget NCM zapnut na $udc"
	else
		echo "!! gadget se nepodarilo zapnout"
	fi
	ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
	mkdir -p /dev/pts
	mount -t devpts devpts /dev/pts
	if [ -x /usr/bin/unudhcpd ]; then
		unudhcpd -i usb0 -s 172.16.42.1 -c 172.16.42.2 > /dev/null 2>&1 &
	fi
	if [ -x /usr/bin/busybox-extras ]; then
		busybox-extras telnetd -b 172.16.42.1:23 -l /bin/sh
		echo "Na pocitaci zkus: ping 172.16.42.1 a telnet 172.16.42.1"
	fi
	# Stav spojeni: "not attached" = pocitac nas nevidi, "configured" = funguje.
	(
		last=
		while true; do
			st=$(cat /sys/class/udc/$udc/state 2>/dev/null)
			[ "$st" != "$last" ] && echo "USB stav: $st"
			last=$st
			sleep 1
		done
	) &
	sleep 3
	echo
elif [ "${test_tag#usb}" != "$test_tag" ]; then
	echo "--- USB ---"
	echo "!! Zadny USB radic (UDC). Hlasky kernelu:"
	dmesg | sed -n 's/^.*USBDBG //p'
	dmesg | grep -i -E "dwc3|usbdrd|13200000|131d0000" | tail -n 8
	echo
fi

# Najde /dev/input/eventN zarizeni, jehoz jmeno obsahuje dany text.
evdev_of() {
	awk -v n="$1" '
		/^N: Name=/ { found = index($0, n) }
		/^H: Handlers=/ && found {
			sub(/^H: Handlers=/, "")
			for (i = 1; i <= NF; i++)
				if ($i ~ /^event/) { print "/dev/input/" $i; exit }
		}' /proc/bus/input/devices 2>/dev/null
}

# Dotykova obrazovka: ladici radky ovladace a prubezny vypis souradnic.
tev=$(evdev_of Himax)
if [ -n "$tev" ] || [ "${test_tag#ts}" != "$test_tag" ]; then
	echo "--- DOTYK ---"
	dmesg | sed -n 's/^.*TSDBG //p'
	dmesg | grep -i -E "himax|hx83|s3c-i2c|13870000" | grep -v TSDBG | tail -n 5 | cut -c1-110
	if [ -n "$tev" ]; then
		echo "Sahni na displej: vypisuji kazdou desatou polohu (x 0-1079, y 0-2519)."
		# struct input_event: 16 B cas, u16 typ, u16 kod, s32 hodnota = 12 slov.
		# Typ 3 = EV_ABS, kod 53/54 = ABS_MT_POSITION_X/Y, typ 0 = konec hlaseni.
		# Pres cat: hexdump cte po kouscich mensich nez jedna udalost a evdev
		# takove cteni odmita (EINVAL); v TS1/TS2 proto vypis nefungoval.
		cat "$tev" | hexdump -v -e '12/2 "%u " "\n"' | awk '
			$9 == 3 && $10 == 53 { x = $11 }
			$9 == 3 && $10 == 54 { y = $11 }
			$9 == 0 && $10 == 0 { if (n++ % 10 == 0) { printf "DOTYK x=%d y=%d\n", x, y; fflush() } }' &
	else
		echo "!! Dotykove zarizeni se neobjevilo."
	fi
	echo
fi

# Restart a vypnuti: co nechal bootloader v registrech PMU (ladici radky
# kernelu "PMUDBG" prijdou az 3 s po startu ovladace PMU) a jestli se
# navazaly ovladace syscon-reboot, syscon-poweroff a syscon-reboot-mode.
rb_test=
[ "${test_tag#rb}" != "$test_tag" ] && rb_test=1
if [ -n "$rb_test" ]; then
	echo "--- RESTART A VYPNUTI ---"
	i=0
	while [ $i -lt 8 ] && ! dmesg | grep -q "PMUDBG SYSIP_DAT0"; do
		sleep 1
		i=$((i + 1))
	done
	dmesg | sed -n 's/^.*PMUDBG \([A-Z_0-9]* = .*\)$/\1/p'
	dmesg | grep -q "PMUDBG SYSIP_DAT0" || echo "!! Vypis PMUDBG neni uplny."
	for d in syscon-reboot syscon-poweroff reboot-mode; do
		n=$(ls -d /sys/bus/platform/devices/*:$d 2>/dev/null | head -n 1)
		if [ -n "$n" ] && [ -e "$n/driver" ]; then
			echo "$d: ovladac navazan"
		else
			echo "!! $d: ovladac NENI navazan"
		fi
	done
	dmesg | grep -i -E "syscon-(reboot|poweroff)|reboot-mode|exynos-pmu|Internal error" | grep -v PMUDBG | tail -n 5 | cut -c1-110
	echo
fi

# GPU: hodiny CMU_G3D, jak je nechal bootloader, hlaseni ovladace panfrost
# a jestli vznikl uzel pro vykreslovani (renderD*). Nic se nenastavuje.
if [ "${test_tag#gpu}" != "$test_tag" ]; then
	echo "--- GPU ---"
	for c in fout_g3d_pll dout_cmu_g3d_switch mout_clk_g3d_busd \
		gout_clk_g3d_g3d_clk gout_g3d_busp_clk; do
		awk -v c="$c" '$1 == c { printf " %-24s %s Hz\n", $1, $5 }' $s
	done
	dmesg | sed -n 's/^.*CLKDBG \(clock-controller@11430000.*\)$/\1/p'
	dmesg | grep -i -E "panfrost|mali|11500000|Internal error|SError" | tail -n 12 | cut -c1-110
	if ls /dev/dri/renderD* > /dev/null 2>&1; then
		echo "uzly DRM: $(ls /dev/dri | tr '\n' ' ')"
	else
		echo "!! /dev/dri/renderD* neni - panfrost se nenavazal."
	fi
	echo
fi

# Podsviceni: sbernice HSI2C_3 a cip SGM37603A na adrese 0x36. Registry se
# jen ctou (stejne, jake cte puvodni ovladac pri startu); nic se nezapisuje.
if [ "${test_tag#bl}" != "$test_tag" ]; then
	echo "--- PODSVICENI ---"
	dmesg | grep -i -E "11d10000|exynos-usi|hsi2c|sysreg" | tail -n 6 | cut -c1-110
	bl_bus=
	for a in /sys/bus/i2c/devices/i2c-*; do
		[ -e "$a" ] || continue
		case "$(readlink -f "$a")" in
			*11d10000.i2c*) bl_bus="${a##*-}" ;;
		esac
	done
	if [ -n "$bl_bus" ]; then
		echo "sbernice: i2c-$bl_bus"
		for r in 10 11 19 1a 1b 1f; do
			echo " reg 0x$r = $(/bin/i2c-reg "$bl_bus" 36 "$r" 2>&1)"
		done
	else
		echo "!! Sbernice 11d10000.i2c se neobjevila."
	fi
	echo
fi

echo "Vstupni zarizeni:"
grep -E '^N: Name|^H: Handlers' /proc/bus/input/devices 2>/dev/null
echo

ev=$(evdev_of gpio-keys)
if [ -z "$ev" ]; then
	echo "!! Zadne /dev/input/event* - gpio-keys se nenacetly."
	echo "dmesg (pinctrl/gpio/keys):"
	dmesg | grep -i -E 'pinctrl|gpio|keys' | tail -n 15
	echo "Cekam. Vypni telefon podrzenim Power + Vol-."
	while true; do sleep 60; done
fi

echo "Mackej tlacitka (Vol+ = 115, Vol- = 114, Power = 116)."
echo "Vypnuti: podrz Power + Vol- asi 10 s."
if [ -n "$rb_test" ]; then
	echo
	echo "TEST RESTARTU - akce se provede po PUSTENI tlacitka:"
	echo "  Vol+   restart do bootloaderu (fastboot)"
	echo "  Power  obycejny restart"
	echo "  Vol-   vypnuti"
fi
echo

# Provede restart nebo vypnuti; kdyz se prikaz vrati, nepovedlo se to.
rb_action() {
	echo ">>> $1"
	echo 7 > /proc/sys/kernel/printk
	sleep 1
	shift
	"$@"
	sleep 5
	echo "!! Prikaz se vratil, telefon bezi dal."
	echo 3 > /proc/sys/kernel/printk
}

# struct input_event na arm64: 16 B cas, u16 type, u16 code, s32 value.
# od vypise 16 B na radek, takze type/code/value jsou na druhem radku.
while true; do
	key=$(dd if="$ev" bs=24 count=1 2>/dev/null | od -An -v -tu2 |
		awk 'NR == 2 && $1 == 1 { printf "KLAVESA code=%d %s\n", $2, ($3 ? "STISK" : "UVOLNENI") }')
	[ -n "$key" ] && echo "$key"
	[ -n "$rb_test" ] || continue
	case "$key" in
	"KLAVESA code=115 UVOLNENI") rb_action "Restart do bootloaderu" /bin/reboot-arg bootloader ;;
	"KLAVESA code=116 UVOLNENI") rb_action "Obycejny restart" reboot -f ;;
	"KLAVESA code=114 UVOLNENI") rb_action "Vypnuti" poweroff -f ;;
	esac
done
