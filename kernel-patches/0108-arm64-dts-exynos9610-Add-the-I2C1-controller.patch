From 2a3b22e776e0a4e07bf29c42fb3a953efb7647b4 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:28:26 +0100
Subject: [PATCH 108/112] arm64: dts: exynos9610: Add the I2C1 controller

The bus of the S2MU106 PMIC (0x3d) and of the charger S2MCS02 in the stock
device tree.

Signed-off-by: letress <vikypl@gmail.com>
---
 arch/arm64/boot/dts/exynos/exynos9610-troika.dts |  8 ++++++++
 arch/arm64/boot/dts/exynos/exynos9610.dtsi       | 14 ++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
index 357bb73..469e02f 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
@@ -210,6 +210,14 @@ fuel-gauge@3b {
 	};
 };
 
+/*
+ * I2C1 carries the S2MU106 PMIC (0x3d: MUIC, charger, haptic, flash LEDs) and
+ * the charger S2MCS02 (0x41) in the stock device tree.
+ */
+&i2c_1 {
+	status = "okay";
+};
+
 &i2c_4 {
 	samsung,i2c-max-bus-freq = <400000>;
 	status = "okay";
diff --git a/arch/arm64/boot/dts/exynos/exynos9610.dtsi b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
index 69a3315..5cc9d1e 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
@@ -573,6 +573,20 @@ i2c_0: i2c@13830000 {
 			status = "disabled";
 		};
 
+		i2c_1: i2c@13840000 {
+			compatible = "samsung,s3c2440-i2c";
+			reg = <0x13840000 0x100>;
+			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2c1_bus>;
+			clocks = <&cmu_peri CLK_GOUT_PERI_I2C_1_PCLK>;
+			clock-names = "i2c";
+
+			status = "disabled";
+		};
+
 		i2c_4: i2c@13870000 {
 			compatible = "samsung,s3c2440-i2c";
 			reg = <0x13870000 0x100>;
