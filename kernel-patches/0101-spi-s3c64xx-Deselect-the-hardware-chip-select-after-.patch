From c1e113c9e2324f2e778c79b47ba8041721441d21 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Sat, 14 Nov 2026 12:17:35 +0100
Subject: [PATCH] spi: s3c64xx: Deselect the hardware chip select after a
 message

A controller that drives its own chip select pin in manual mode selected
the device at the first transfer and never released it again, because the
driver did not register set_cs with the SPI core. The device then saw all
later transfers as one long transaction.

Pass the line level the core asks for to the existing helper. Controllers
with automatic chip select and those with a GPIO chip select behave as
before.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/spi/spi-s3c64xx.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/spi/spi-s3c64xx.c b/drivers/spi/spi-s3c64xx.c
index 33ad866..b706e9b 100644
--- a/drivers/spi/spi-s3c64xx.c
+++ b/drivers/spi/spi-s3c64xx.c
@@ -383,6 +383,17 @@ static void s3c64xx_spi_set_cs(struct spi_device *spi, bool enable)
 	}
 }
 
+/*
+ * Called by the SPI core with the level of the chip select line. Without
+ * this a controller that drives its own chip select pin in manual mode keeps
+ * the device selected after the first transfer, and the device sees all later
+ * transfers as one long transaction.
+ */
+static void s3c64xx_spi_core_set_cs(struct spi_device *spi, bool level)
+{
+	s3c64xx_spi_set_cs(spi, !level);
+}
+
 static int s3c64xx_spi_prepare_transfer(struct spi_controller *spi)
 {
 	struct s3c64xx_spi_driver_data *sdd = spi_controller_get_devdata(spi);
@@ -1311,6 +1322,7 @@ static int s3c64xx_spi_probe(struct platform_device *pdev)
 	host->prepare_transfer_hardware = s3c64xx_spi_prepare_transfer;
 	host->unprepare_transfer_hardware = s3c64xx_spi_unprepare_transfer;
 	host->prepare_message = s3c64xx_spi_prepare_message;
+	host->set_cs = s3c64xx_spi_core_set_cs;
 	host->transfer_one = s3c64xx_spi_transfer_one;
 	host->max_transfer_size = s3c64xx_spi_max_transfer_size;
 	host->num_chipselect = sci->num_cs;
-- 
