diff --git a/drivers/gpu/drm/exynos9610/exynos9610_dpu.c b/drivers/gpu/drm/exynos9610/exynos9610_dpu.c
new file mode 100644
index 0000000..cb018f4
--- /dev/null
+++ b/drivers/gpu/drm/exynos9610/exynos9610_dpu.c
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Display controller of the Exynos9610 (DECON0 with the DMA/DPP unit of window 0).
+ *
+ * The bootloader leaves the panel running: DSIM, the D-PHY, the panel and the
+ * DECON timing are all set up and a frame buffer is scanned out through
+ * window 0. This driver takes that state over and changes only what a frame
+ * buffer flip needs: the base address of the read DMA of window 0 and the
+ * shadow update of that window. It does not touch the clocks, the power
+ * domain, DSIM or the panel; the display is switched off through its backlight.
+ *
+ * Register offsets and the update sequence come from the vendor driver
+ * (drivers/video/fbdev/exynos/dpu20, cal_9610/regs-decon.h and regs-dpp.h);
+ * the state it expects was read from the phone after the bootloader.
+ */
+
+#include <linux/backlight.h>
+#include <linux/bitfield.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <video/of_display_timing.h>
+#include <video/videomode.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_atomic_helper.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_module.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+/* DECON (regs-decon.h) */
+#define DECON_INTERRUPT_ENABLE		0x0040
+#define DECON_FRAME_START_INT		BIT(12)
+#define DECON_FRAME_DONE_INT		BIT(13)
+#define DECON_INTERRUPT_PENDING		0x004c
+#define DECON_SHADOW_REG_UPDATE_REQ	0x0060
+#define DECON_SHADOW_REQ_WIN(w)		BIT(w)
+
+/* The read DMA of the window (regs-dpp.h, IDMA_*) */
+#define IDMA_IN_CON			0x0008
+#define IDMA_IMG_FORMAT_MASK		GENMASK(16, 11)
+#define IDMA_IMG_FORMAT_XRGB8888	4
+#define IDMA_SRC_SIZE			0x0010	/* size of the whole buffer: stride in pixels, height */
+#define IDMA_SRC_HEIGHT(h)		((h) << 16)
+#define IDMA_SRC_WIDTH(w)		(w)
+#define IDMA_SRC_WIDTH_MASK		GENMASK(15, 0)
+#define IDMA_IN_BASE_ADDR_Y		0x0040
+
+#define DPU_WIN			0
+
+struct dpu {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	struct drm_display_mode mode;
+	void __iomem *decon;
+	void __iomem *idma;
+	struct backlight_device *backlight;
+	u32 width_mm, height_mm;
+};
+
+#define to_dpu(d)	container_of(d, struct dpu, drm)
+
+/* No ARGB8888: the plane has no blend mode property, the alpha is ignored */
+static const u32 dpu_formats[] = {
+	DRM_FORMAT_XRGB8888,
+};
+
+static int dpu_connector_get_modes(struct drm_connector *connector)
+{
+	struct dpu *dpu = to_dpu(connector->dev);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &dpu->mode);
+	if (!mode)
+		return 0;
+
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = dpu->width_mm;
+	connector->display_info.height_mm = dpu->height_mm;
+
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs dpu_connector_helper_funcs = {
+	.get_modes = dpu_connector_get_modes,
+};
+
+static const struct drm_connector_funcs dpu_connector_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+static enum drm_mode_status dpu_mode_valid(struct drm_simple_display_pipe *pipe,
+					   const struct drm_display_mode *mode)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	if (mode->hdisplay != dpu->mode.hdisplay ||
+	    mode->vdisplay != dpu->mode.vdisplay)
+		return MODE_BAD;
+
+	return MODE_OK;
+}
+
+/* The DMA takes the stride as the width of the buffer in pixels */
+static int dpu_check(struct drm_simple_display_pipe *pipe,
+		     struct drm_plane_state *plane_state,
+		     struct drm_crtc_state *crtc_state)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+	struct drm_framebuffer *fb = plane_state->fb;
+
+	if (!fb)
+		return 0;
+
+	if (fb->width < dpu->mode.hdisplay || fb->height < dpu->mode.vdisplay ||
+	    fb->pitches[0] % 4 || fb->pitches[0] / 4 > IDMA_SRC_WIDTH_MASK)
+		return -EINVAL;
+
+	return 0;
+}
+
+static void dpu_enable(struct drm_simple_display_pipe *pipe,
+		       struct drm_crtc_state *crtc_state,
+		       struct drm_plane_state *plane_state)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	drm_crtc_vblank_on(&pipe->crtc);
+	if (dpu->backlight)
+		backlight_enable(dpu->backlight);
+}
+
+static void dpu_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	if (dpu->backlight)
+		backlight_disable(dpu->backlight);
+	drm_crtc_vblank_off(&pipe->crtc);
+}
+
+static void dpu_update(struct drm_simple_display_pipe *pipe,
+		       struct drm_plane_state *old_state)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+	struct drm_plane_state *state = pipe->plane.state;
+	struct drm_crtc *crtc = &pipe->crtc;
+	struct drm_pending_vblank_event *event;
+	u32 val;
+
+	if (state->fb) {
+		val = readl(dpu->idma + IDMA_IN_CON) & ~IDMA_IMG_FORMAT_MASK;
+		val |= FIELD_PREP(IDMA_IMG_FORMAT_MASK, IDMA_IMG_FORMAT_XRGB8888);
+		writel(val, dpu->idma + IDMA_IN_CON);
+		writel(IDMA_SRC_HEIGHT(state->fb->height) |
+		       IDMA_SRC_WIDTH(state->fb->pitches[0] / 4),
+		       dpu->idma + IDMA_SRC_SIZE);
+		writel(drm_fb_dma_get_gem_addr(state->fb, state, 0),
+		       dpu->idma + IDMA_IN_BASE_ADDR_Y);
+		writel(DECON_SHADOW_REQ_WIN(DPU_WIN),
+		       dpu->decon + DECON_SHADOW_REG_UPDATE_REQ);
+	}
+
+	spin_lock_irq(&crtc->dev->event_lock);
+	event = crtc->state->event;
+	if (event) {
+		crtc->state->event = NULL;
+		if (drm_crtc_vblank_get(crtc) == 0)
+			drm_crtc_arm_vblank_event(crtc, event);
+		else
+			drm_crtc_send_vblank_event(crtc, event);
+	}
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
+
+static int dpu_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	writel(DECON_FRAME_START_INT, dpu->decon + DECON_INTERRUPT_PENDING);
+	writel(readl(dpu->decon + DECON_INTERRUPT_ENABLE) | DECON_FRAME_START_INT,
+	       dpu->decon + DECON_INTERRUPT_ENABLE);
+
+	return 0;
+}
+
+static void dpu_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	writel(readl(dpu->decon + DECON_INTERRUPT_ENABLE) & ~DECON_FRAME_START_INT,
+	       dpu->decon + DECON_INTERRUPT_ENABLE);
+}
+
+static const struct drm_simple_display_pipe_funcs dpu_pipe_funcs = {
+	.mode_valid = dpu_mode_valid,
+	.check = dpu_check,
+	.enable = dpu_enable,
+	.disable = dpu_disable,
+	.update = dpu_update,
+	.enable_vblank = dpu_enable_vblank,
+	.disable_vblank = dpu_disable_vblank,
+};
+
+static irqreturn_t dpu_irq(int irq, void *data)
+{
+	struct dpu *dpu = data;
+	u32 pending = readl(dpu->decon + DECON_INTERRUPT_PENDING);
+
+	/* the bit is cleared by writing 1; leave every other cause alone */
+	pending &= DECON_FRAME_START_INT | DECON_FRAME_DONE_INT;
+	if (!pending)
+		return IRQ_NONE;
+
+	writel(pending, dpu->decon + DECON_INTERRUPT_PENDING);
+	if (pending & DECON_FRAME_START_INT)
+		drm_crtc_handle_vblank(&dpu->pipe.crtc);
+
+	return IRQ_HANDLED;
+}
+
+static const struct drm_mode_config_funcs dpu_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(dpu_fops);
+
+static const struct drm_driver dpu_driver = {
+	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_ATOMIC,
+	.name = "exynos9610-dpu",
+	.desc = "Exynos9610 display controller",
+	.major = 1,
+	.minor = 0,
+	.fops = &dpu_fops,
+	DRM_GEM_DMA_DRIVER_OPS,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+};
+
+static int dpu_read_mode(struct device *dev, struct dpu *dpu)
+{
+	struct device_node *np = dev->of_node;
+	struct display_timing timing;
+	struct videomode vm;
+	int ret;
+
+	ret = of_get_display_timing(np, "panel-timing", &timing);
+	if (ret)
+		return dev_err_probe(dev, ret, "no panel-timing\n");
+
+	videomode_from_timing(&timing, &vm);
+	drm_display_mode_from_videomode(&vm, &dpu->mode);
+	dpu->mode.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(&dpu->mode);
+
+	of_property_read_u32(np, "width-mm", &dpu->width_mm);
+	of_property_read_u32(np, "height-mm", &dpu->height_mm);
+
+	return 0;
+}
+
+static int dpu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct drm_device *drm;
+	struct dpu *dpu;
+	u32 size;
+	int irq, ret;
+
+	dpu = devm_drm_dev_alloc(dev, &dpu_driver, struct dpu, drm);
+	if (IS_ERR(dpu))
+		return PTR_ERR(dpu);
+	drm = &dpu->drm;
+
+	dpu->decon = devm_platform_ioremap_resource_byname(pdev, "decon");
+	if (IS_ERR(dpu->decon))
+		return PTR_ERR(dpu->decon);
+	dpu->idma = devm_platform_ioremap_resource_byname(pdev, "idma");
+	if (IS_ERR(dpu->idma))
+		return PTR_ERR(dpu->idma);
+
+	ret = dpu_read_mode(dev, dpu);
+	if (ret)
+		return ret;
+
+	/* the panel has no power control here; the display goes dark with its backlight */
+	dpu->backlight = devm_of_find_backlight(dev);
+	if (IS_ERR(dpu->backlight))
+		return dev_err_probe(dev, PTR_ERR(dpu->backlight), "backlight\n");
+
+	/* the read DMA of the bootloader must already scan out the full panel */
+	size = readl(dpu->idma + IDMA_SRC_SIZE);
+	if ((size & IDMA_SRC_WIDTH_MASK) != dpu->mode.hdisplay ||
+	    (size >> 16) != dpu->mode.vdisplay)
+		return dev_err_probe(dev, -ENODEV,
+				     "window 0 is not set up by the bootloader (size 0x%08x)\n",
+				     size);
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.min_width = dpu->mode.hdisplay;
+	drm->mode_config.max_width = dpu->mode.hdisplay;
+	drm->mode_config.min_height = dpu->mode.vdisplay;
+	drm->mode_config.max_height = dpu->mode.vdisplay;
+	drm->mode_config.funcs = &dpu_mode_config_funcs;
+
+	drm_connector_helper_add(&dpu->connector, &dpu_connector_helper_funcs);
+	ret = drm_connector_init(drm, &dpu->connector, &dpu_connector_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &dpu->pipe, &dpu_pipe_funcs,
+					   dpu_formats, ARRAY_SIZE(dpu_formats),
+					   NULL, &dpu->connector);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, dpu_irq, 0, dev_name(dev), dpu);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, drm);
+	drm_client_setup_with_fourcc(drm, DRM_FORMAT_XRGB8888);
+
+	return 0;
+}
+
+static void dpu_remove(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	drm_dev_unplug(drm);
+	drm_atomic_helper_shutdown(drm);
+}
+
+static void dpu_shutdown(struct platform_device *pdev)
+{
+	drm_atomic_helper_shutdown(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id dpu_of_match[] = {
+	{ .compatible = "samsung,exynos9610-dpu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dpu_of_match);
+
+static struct platform_driver dpu_platform_driver = {
+	.probe = dpu_probe,
+	.remove = dpu_remove,
+	.shutdown = dpu_shutdown,
+	.driver = {
+		.name = "exynos9610-dpu",
+		.of_match_table = dpu_of_match,
+	},
+};
+drm_module_platform_driver(dpu_platform_driver);
+
+MODULE_DESCRIPTION("Exynos9610 display controller, takes over the bootloader state");
+MODULE_LICENSE("GPL");
