@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_EXYNOS9610_DPU
+	tristate "Exynos9610 display controller (takes over the bootloader state)"
+	depends on DRM && OF && (ARCH_EXYNOS || COMPILE_TEST)
+	select DRM_CLIENT_SELECTION
+	select DRM_GEM_DMA_HELPER
+	select BACKLIGHT_CLASS_DEVICE
+	select DRM_KMS_HELPER
+	select VIDEOMODE_HELPERS
+	help
+	  Flips frame buffers on the panel the bootloader has already set up
+	  on the Exynos9610 (DECON0 with the DMA of window 0). It does not
+	  change the timing or the power of the display.
+
+	  If M is selected the module will be called exynos9610_dpu.
