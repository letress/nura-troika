From b5449e42f365b9fc90e2aa80a5fb325b58f2b005 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Sat, 14 Nov 2026 13:46:25 +0100
Subject: [PATCH 103/103] clk: samsung: exynos9610: Pass SPI rate requests to
 the dividers

The SPI controllers set the rate of their IPCLK gate to get the bus clock,
but the gate did not hand the request to the divider behind it. The
controller kept running from the undivided 399.75 MHz source, about 200 MHz
on the bus.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index 6aad660..aa074cc 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -1293,15 +1293,15 @@ static const struct samsung_gate_clock peri_gate_clks[] __initconst = {
 	GATE(CLK_GOUT_PERI_SPI_0_PCLK, "gout_peri_spi_0_pclk", "mout_pll_peri_bus_user",
 	     CLK_CON_GAT_GOUT_PERI_SPI_0_PCLK, 21, 0, 0),
 	GATE(CLK_GOUT_PERI_SPI_0_IPCLK, "gout_peri_spi_0_ipclk", "dout_clk_peri_spi0",
-	     CLK_CON_GAT_GOUT_PERI_SPI_0_IPCLK, 21, 0, 0),
+	     CLK_CON_GAT_GOUT_PERI_SPI_0_IPCLK, 21, CLK_SET_RATE_PARENT, 0),
 	GATE(CLK_GOUT_PERI_SPI_1_PCLK, "gout_peri_spi_1_pclk", "mout_pll_peri_bus_user",
 	     CLK_CON_GAT_GOUT_PERI_SPI_1_PCLK, 21, 0, 0),
 	GATE(CLK_GOUT_PERI_SPI_1_IPCLK, "gout_peri_spi_1_ipclk", "dout_clk_peri_spi1",
-	     CLK_CON_GAT_GOUT_PERI_SPI_1_IPCLK, 21, 0, 0),
+	     CLK_CON_GAT_GOUT_PERI_SPI_1_IPCLK, 21, CLK_SET_RATE_PARENT, 0),
 	GATE(CLK_GOUT_PERI_SPI_2_PCLK, "gout_peri_spi_2_pclk", "mout_pll_peri_bus_user",
 	     CLK_CON_GAT_GOUT_PERI_SPI_2_PCLK, 21, 0, 0),
 	GATE(CLK_GOUT_PERI_SPI_2_IPCLK, "gout_peri_spi_2_ipclk", "dout_clk_peri_spi2",
-	     CLK_CON_GAT_GOUT_PERI_SPI_2_IPCLK, 21, 0, 0),
+	     CLK_CON_GAT_GOUT_PERI_SPI_2_IPCLK, 21, CLK_SET_RATE_PARENT, 0),
 	GATE(CLK_GOUT_PERI_SYSREG_PCLK, "gout_peri_sysreg_pclk", "mout_pll_peri_bus_user",
 	     CLK_CON_GAT_GOUT_PERI_SYSREG_PCLK, 21, 0, 0),
 	GATE(CLK_GOUT_PERI_UART_IPCLK, "gout_peri_uart_ipclk", "mout_pll_peri_uart_user",
-- 
