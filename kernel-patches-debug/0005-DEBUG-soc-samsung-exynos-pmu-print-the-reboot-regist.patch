From bdef719016590505b24a74fe7a9fc95e46b562c5 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:52:06 +0100
Subject: [PATCH 5/5] DEBUG: soc: samsung: exynos-pmu: print the reboot
 registers of Exynos9610

Not for upstream. Prints RESET_SEQUENCER_CONFIGURATION, PS_HOLD_CONTROL,
SYSIP_DAT3 and SYSIP_DAT0 as the bootloader left them (PMUDBG).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/soc/samsung/exynos-pmu.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/drivers/soc/samsung/exynos-pmu.c b/drivers/soc/samsung/exynos-pmu.c
index 88b0dfc..6bca244 100644
--- a/drivers/soc/samsung/exynos-pmu.c
+++ b/drivers/soc/samsung/exynos-pmu.c
@@ -18,6 +18,7 @@
 #include <linux/delay.h>
 #include <linux/reboot.h>
 #include <linux/regmap.h>
+#include <linux/workqueue.h>
 
 #include <linux/soc/samsung/exynos-regs-pmu.h>
 #include <linux/soc/samsung/exynos-pmu.h>
@@ -472,6 +473,34 @@ static int setup_cpuhp_and_cpuidle(struct device *dev)
 	return 0;
 }
 
+/*
+ * DEBUG: what the bootloader left in the registers the vendor reboot code
+ * uses. Done from a work item, one register per line, so that a register
+ * that cannot be read costs a kworker and names itself in the log.
+ */
+static void exynos9610_pmu_dbg_work(struct work_struct *work)
+{
+	static const struct {
+		unsigned int reg;
+		const char *name;
+	} regs[] = {
+		{ 0x0500, "RESET_SEQUENCER_CONFIGURATION" },
+		{ 0x330c, "PS_HOLD_CONTROL" },
+		{ 0x081c, "SYSIP_DAT3" },
+		{ 0x0810, "SYSIP_DAT0" },
+	};
+	unsigned int i, val;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		pr_info("PMUDBG reading %s (0x%04x)\n", regs[i].name, regs[i].reg);
+		val = 0;
+		ret = regmap_read(pmu_context->pmureg, regs[i].reg, &val);
+		pr_info("PMUDBG %s = 0x%08x (ret %d)\n", regs[i].name, val, ret);
+	}
+}
+static DECLARE_DELAYED_WORK(exynos9610_pmu_dbg, exynos9610_pmu_dbg_work);
+
 static int exynos_pmu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -549,6 +578,9 @@ static int exynos_pmu_probe(struct platform_device *pdev)
 	if (devm_of_platform_populate(dev))
 		dev_err(dev, "Error populating children, reboot and poweroff might not work properly\n");
 
+	if (of_device_is_compatible(dev->of_node, "samsung,exynos9610-pmu"))
+		schedule_delayed_work(&exynos9610_pmu_dbg, 3 * HZ);
+
 	dev_dbg(dev, "Exynos PMU Driver probe done\n");
 	return 0;
 }
