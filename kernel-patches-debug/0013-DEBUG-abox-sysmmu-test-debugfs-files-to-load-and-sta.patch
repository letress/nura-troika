From 0db7e055e7069977f40d1b0c9d07ef2458bb336d Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Fri, 13 Nov 2026 04:39:00 +0100
Subject: [PATCH 13/14] DEBUG: abox-sysmmu-test: debugfs files to load and
 start the ABOX firmware

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/iommu/abox-sysmmu-test.c | 191 ++++++++++++++++++++++++++++++-
 1 file changed, 190 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/abox-sysmmu-test.c b/drivers/iommu/abox-sysmmu-test.c
index a4292e2..901f0f9 100644
--- a/drivers/iommu/abox-sysmmu-test.c
+++ b/drivers/iommu/abox-sysmmu-test.c
@@ -7,6 +7,11 @@
  * System MMU is programmed by exynos-iommu itself through the IOMMU API.
  */
 
+#include <dt-bindings/clock/samsung,exynos9610-cmu.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/debugfs.h>
+#include <linux/firmware.h>
 #include <linux/io.h>
 #include <linux/iommu.h>
 #include <linux/init.h>
@@ -14,7 +19,10 @@
 #include <linux/of.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
+#include <linux/mfd/syscon.h>
 #include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
 #include <linux/sizes.h>
 #include <linux/string.h>
 
@@ -23,6 +31,27 @@
 #define ABOX_RDMA_TEST_CHANNEL		1
 #define ABOX_TEST_PATTERN_BYTES		0x3c00		/* 3840 frames * 4 bytes */
 
+/* From the stock device tree and from abox.c / abox.h of the vendor kernel */
+#define ABOX_SRAM_BASE		0x14b00000UL	/* "sram" reg of the abox node */
+#define ABOX_SRAM_SIZE		0x35000UL
+#define ABOX_IPC_TX_OFFSET	0x22000		/* ipc_tx_offset */
+#define ABOX_IPC_RX_OFFSET	0x22300		/* ipc_rx_offset */
+#define ABOX_DRAM_FW_SIZE	(SZ_8M + SZ_4M)	/* DRAM_FIRMWARE_SIZE */
+#define ABOX_PMU_CPU_CONFIGURATION	0x2520	/* ABOX_CPU_CONFIGURATION */
+#define ABOX_PMU_CPU_STATUS		0x2524	/* ABOX_CPU_STATUS */
+#define ABOX_PMU_CPU_OPTION		0x2528	/* ABOX_CPU_OPTION */
+#define ABOX_PMU_CPU_ENABLE		BIT(15)	/* ABOX_CPU_OPTION_ENABLE_CPU_MASK */
+#define ABOX_PMU_CPU_RUNNING		BIT(0)	/* ABOX_CPU_STATUS_STATUS_MASK */
+
+static struct {
+	struct device *dev;
+	struct regmap *pmu;
+	void *dram;			/* firmware memory, mapped at IOVA 0x80000000 */
+	void __iomem *sram;
+	bool loaded;
+	bool started;
+} abox_fw;
+
 static int abox_test_map(struct device *dev, int idx, unsigned long iova,
 			 struct iommu_domain *domain, void **virt)
 {
@@ -46,7 +75,7 @@ static int abox_test_map(struct device *dev, int idx, unsigned long iova,
 		return ret;
 
 	if (virt)
-		*virt = memremap(rmem->base, rmem->size, MEMREMAP_WB);
+		*virt = memremap(rmem->base, rmem->size, MEMREMAP_WC);
 
 	return 0;
 }
@@ -65,6 +94,149 @@ static int abox_test_fault(struct iommu_domain *domain, struct device *dev,
 	return 0;
 }
 
+static void abox_fw_clocks(struct device *dev)
+{
+	static const unsigned int gates[] = {
+		CLK_GOUT_DISPAUD_ABOX_CCLK_ASB,
+		CLK_GOUT_DISPAUD_ABOX_CCLK_CA7,
+	};
+	struct device_node *np;
+	unsigned int i;
+
+	np = of_find_compatible_node(NULL, NULL, "samsung,exynos9610-cmu-dispaud");
+	if (!np)
+		return;
+	for (i = 0; i < ARRAY_SIZE(gates); i++) {
+		struct of_phandle_args args = {
+			.np = np, .args_count = 1, .args = { gates[i] },
+		};
+		struct clk *clk = of_clk_get_from_provider(&args);
+
+		if (IS_ERR(clk))
+			continue;
+		dev_info(dev, "ABOXFW: clock gate %u: %d\n", gates[i],
+			 clk_prepare_enable(clk));
+	}
+	of_node_put(np);
+}
+
+static void abox_fw_dump(struct seq_file *m)
+{
+	unsigned int cfg = 0, status = 0, opt = 0, i;
+
+	regmap_read(abox_fw.pmu, ABOX_PMU_CPU_CONFIGURATION, &cfg);
+	regmap_read(abox_fw.pmu, ABOX_PMU_CPU_STATUS, &status);
+	regmap_read(abox_fw.pmu, ABOX_PMU_CPU_OPTION, &opt);
+	seq_printf(m, "loaded %d started %d\n", abox_fw.loaded, abox_fw.started);
+	seq_printf(m, "pmu cpu configuration %#x status %#x option %#x\n",
+		   cfg, status, opt);
+	if (!abox_fw.loaded)
+		return;
+	seq_puts(m, "ipc tx:");
+	for (i = 0; i < 8; i++)
+		seq_printf(m, " %08x", readl(abox_fw.sram + ABOX_IPC_TX_OFFSET + 4 * i));
+	seq_puts(m, "\nipc rx:");
+	for (i = 0; i < 8; i++)
+		seq_printf(m, " %08x", readl(abox_fw.sram + ABOX_IPC_RX_OFFSET + 4 * i));
+	seq_puts(m, "\n");
+}
+
+static int abox_fw_status_show(struct seq_file *m, void *unused)
+{
+	abox_fw_dump(m);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(abox_fw_status);
+
+/* Copy the two firmware images where the vendor driver puts them */
+static int abox_fw_load_set(void *data, u64 val)
+{
+	const struct firmware *fw_sram, *fw_dram;
+	struct device *dev = abox_fw.dev;
+	int ret;
+
+	if (val != 1 || abox_fw.loaded)
+		return -EINVAL;
+
+	ret = request_firmware(&fw_sram, "calliope_sram.bin", dev);
+	if (ret)
+		return ret;
+	ret = request_firmware(&fw_dram, "calliope_dram.bin", dev);
+	if (ret)
+		goto release_sram;
+
+	if (fw_sram->size > ABOX_SRAM_SIZE || fw_dram->size > ABOX_DRAM_FW_SIZE) {
+		ret = -EFBIG;
+		goto release;
+	}
+
+	abox_fw_clocks(dev);
+	abox_fw.sram = ioremap(ABOX_SRAM_BASE, ABOX_SRAM_SIZE);
+	if (!abox_fw.sram) {
+		ret = -ENOMEM;
+		goto release;
+	}
+
+	memcpy_toio(abox_fw.sram, fw_sram->data, fw_sram->size);
+	memset_io(abox_fw.sram + fw_sram->size, 0, ABOX_SRAM_SIZE - fw_sram->size);
+	memcpy(abox_fw.dram, fw_dram->data, fw_dram->size);
+	memset(abox_fw.dram + fw_dram->size, 0, ABOX_DRAM_FW_SIZE - fw_dram->size);
+
+	dev_info(dev, "ABOXFW: loaded sram %zu bytes, dram %zu bytes; first sram word %08x, first dram word %08x\n",
+		 fw_sram->size, fw_dram->size, readl(abox_fw.sram),
+		 *(u32 *)abox_fw.dram);
+	abox_fw.loaded = true;
+release:
+	release_firmware(fw_dram);
+release_sram:
+	release_firmware(fw_sram);
+
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(abox_fw_load_fops, NULL, abox_fw_load_set, "%llu\n");
+
+/* Let the audio processor run (cpu_enable() of the vendor driver) */
+static int abox_fw_start_set(void *data, u64 val)
+{
+	struct device *dev = abox_fw.dev;
+	unsigned int status = 0, i;
+
+	if (val != 1 || !abox_fw.loaded || abox_fw.started)
+		return -EINVAL;
+
+	regmap_update_bits(abox_fw.pmu, ABOX_PMU_CPU_OPTION, ABOX_PMU_CPU_ENABLE,
+			   ABOX_PMU_CPU_ENABLE);
+	abox_fw.started = true;
+	for (i = 0; i < 100; i++) {
+		regmap_read(abox_fw.pmu, ABOX_PMU_CPU_STATUS, &status);
+		if (status & ABOX_PMU_CPU_RUNNING)
+			break;
+		msleep(10);
+	}
+	dev_info(dev, "ABOXFW: cpu enabled, status %#x after %u ms\n", status,
+		 i * 10);
+
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(abox_fw_start_fops, NULL, abox_fw_start_set, "%llu\n");
+
+/* Hold the audio processor again (cpu_enable(false)) */
+static int abox_fw_stop_set(void *data, u64 val)
+{
+	unsigned int status = 0;
+
+	if (val != 1)
+		return -EINVAL;
+
+	regmap_update_bits(abox_fw.pmu, ABOX_PMU_CPU_OPTION, ABOX_PMU_CPU_ENABLE, 0);
+	abox_fw.started = false;
+	regmap_read(abox_fw.pmu, ABOX_PMU_CPU_STATUS, &status);
+	dev_info(abox_fw.dev, "ABOXFW: cpu disabled, status %#x\n", status);
+
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(abox_fw_stop_fops, NULL, abox_fw_stop_set, "%llu\n");
+
 static int abox_test_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -100,6 +272,8 @@ static int abox_test_probe(struct platform_device *pdev)
 	ret = abox_test_map(dev, 0, ABOX_IOVA_DRAM_FIRMWARE, domain, &fw);
 	if (ret)
 		return ret;
+	abox_fw.dev = dev;
+	abox_fw.dram = fw;
 	ret = abox_test_map(dev, 1, ABOX_IOVA_RDMA_BUFFER(ABOX_RDMA_TEST_CHANNEL),
 			    domain, (void **)&buf);
 	if (ret)
@@ -118,6 +292,21 @@ static int abox_test_probe(struct platform_device *pdev)
 		 &(phys_addr_t){ iommu_iova_to_phys(domain,
 				ABOX_IOVA_RDMA_BUFFER(ABOX_RDMA_TEST_CHANNEL)) });
 
+	/*
+	 * Nothing happens to the audio processor until somebody writes to the
+	 * files below, in this order: load, start (stop to hold it again).
+	 */
+	abox_fw.pmu = syscon_regmap_lookup_by_compatible("samsung,exynos9610-pmu");
+	if (!IS_ERR(abox_fw.pmu) && abox_fw.dram) {
+		struct dentry *dir = debugfs_create_dir("abox-fw", NULL);
+
+		debugfs_create_file("status", 0400, dir, NULL, &abox_fw_status_fops);
+		debugfs_create_file("load", 0200, dir, NULL, &abox_fw_load_fops);
+		debugfs_create_file("start", 0200, dir, NULL, &abox_fw_start_fops);
+		debugfs_create_file("stop", 0200, dir, NULL, &abox_fw_stop_fops);
+		dev_info(dev, "ABOXFW: debugfs files ready, nothing done\n");
+	}
+
 	return 0;
 }
 
