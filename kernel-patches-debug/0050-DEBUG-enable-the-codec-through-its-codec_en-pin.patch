From 8fc1fcc8b5b2f069f68884296de3e0e4452fe612 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:35:19 +0100
Subject: [PATCH 50/63] DEBUG: enable the codec through its codec_en pin

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos9610-troika.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
index 2ee48a9..f0e39f4 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
@@ -430,3 +430,16 @@ controller-data {
 		};
 	};
 };
+
+/*
+ * gpg1-1 "codec_en" of the vendor tree: output, high, pull-up. It is part of
+ * the pinctrl of the codec SPI controller there and powers the codec.
+ */
+&gpg1 {
+	codec-en-hog {
+		gpio-hog;
+		gpios = <1 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "codec-en";
+	};
+};
-- 
