From 249c648a55288b0846b575af4f4e1f44fa1080c8 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:53:55 +0100
Subject: [PATCH 01/14] DEBUG: clk: samsung: report option registers and power
 domain state

Not for upstream and not for the package. Prints the CMU option
register before and after automatic clock gating is enabled, and the
state of the power domains as the bootloader left them (read-only).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos-arm64.c |  6 +++++
 drivers/clk/samsung/clk-exynos9610.c   | 35 ++++++++++++++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/drivers/clk/samsung/clk-exynos-arm64.c b/drivers/clk/samsung/clk-exynos-arm64.c
index 35d4de2..864ed08 100644
--- a/drivers/clk/samsung/clk-exynos-arm64.c
+++ b/drivers/clk/samsung/clk-exynos-arm64.c
@@ -107,8 +107,14 @@ static void __init exynos_arm64_init_clocks(struct device_node *np,
 		 * This overrides the individual HWACG bits in each of the
 		 * individual gate, mux and qch registers.
 		 */
+		u32 before = readl(reg_base + cmu->option_offset);
+
 		writel(CMU_OPT_GLOBAL_EN_AUTO_GATING,
 		       reg_base + cmu->option_offset);
+		pr_info("CLKDBG %pOFP: option %#x -> %#x\n", np, before,
+			readl(reg_base + cmu->option_offset));
+	} else {
+		pr_info("CLKDBG %pOFP: auto gating off\n", np);
 	}
 
 	for (i = 0; i < reg_offs_len; ++i) {
diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index 6aad660..331ffd1 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -3737,3 +3737,38 @@ static int __init exynos9610_cmu_init(void)
 	return platform_driver_register(&exynos9610_cmu_driver);
 }
 core_initcall(exynos9610_cmu_init);
+
+/*
+ * DEBUG, not for upstream: report which power domains the bootloader left on.
+ * Read-only. Status registers as used by the vendor kernel
+ * (cal-if/exynos9610/pmucal_local_exynos9610.h): PMU at 0x11860000, a domain
+ * is on when the low four bits read 0xf.
+ */
+static int __init exynos9610_pd_status_debug(void)
+{
+	static const struct {
+		const char *name;
+		u32 offset;
+	} pd[] = {
+		{ "dispaud", 0x4004 }, { "cam", 0x4024 }, { "g2d", 0x4044 },
+		{ "g3d", 0x4064 }, { "isp", 0x4084 }, { "mfc", 0x40a4 },
+		{ "vipx1", 0x40e4 },
+	};
+	void __iomem *pmu;
+	int i;
+
+	if (!of_machine_is_compatible("samsung,exynos9610"))
+		return 0;
+
+	pmu = ioremap(0x11860000, 0x5000);
+	if (!pmu)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(pd); i++)
+		pr_info("CLKDBG pd %s: status %#x\n", pd[i].name,
+			readl(pmu + pd[i].offset));
+
+	iounmap(pmu);
+	return 0;
+}
+late_initcall(exynos9610_pd_status_debug);
-- 
