+/*
+ * LDO42 of the S2MPU09 PMIC (vdd_ldo42, "always-on" in the vendor tree). It
+ * powers the audio codec and the amplifier and is off after a cold start. The
+ * values are those of the vendor driver: the PMIC is reached through the ACPM
+ * channel 2 (acpm-ipc-channel of the s2mpu09mfd node), its address is
+ * I2C_ADDR_PMIC = 1, the control register is S2MPU09_PMIC_REG_L42CTRL (0x63)
+ * with the enable bits 7:6 (S2MPU09_ENABLE_MASK) and the voltage code 0x2c in
+ * the rest (700 mV + 44 * 25 mV = 1.8 V, left by the bootloader).
+ */
+/ {
+	ldo42: regulator-ldo42 {
+		compatible = "samsung,exynos9610-acpm-ldo";
+		samsung,acpm-ipc = <&acpm>;
+		samsung,acpm-channel = <2>;
+		samsung,pmic-type = <1>;
+		samsung,register = <0x63>;
+		samsung,enable-mask = <0xc0>;
+		samsung,voltage-code = <0x2c>;
+		regulator-name = "vdd_ldo42";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+};
+
 /*
  * Speaker amplifier on SPI6, values from the live device tree of the stock
- * system. Its supplies (LDO42 and V_SYS) are on from boot and not described.
+ * system. Its supply V_SYS is on from boot and not described.
  */
