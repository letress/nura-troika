@@ -107,6 +107,7 @@
 #define ABOX_IPC_PCMPLAYBACK		2
 #define ABOX_IPC_ABOX_CONFIG		0xa
 #define ABOX_SYS_BOOT_DONE		3
+#define ABOX_SYS_REPORT_FAULT		0xfa
 #define PCM_OPEN			0xb
 #define PCM_CLOSE			0xc
 #define PCM_HW_PARAMS			0xe
@@ -120,6 +121,7 @@
 
 #define ABOX_IPC_GAP_MS			300
 #define ABOX_BOOT_SETTLE_MS		2000
+#define ABOX_START_TRIES		4
 #define ABOX_RATE			48000
 #define ABOX_PERIOD_BYTES		3840
 #define ABOX_PERIODS			4
@@ -143,6 +145,7 @@ struct abox {
 	struct snd_pcm_substream *substream;
 	u32 ptr;			/* position of the RDMA in bytes, from the last period interrupt */
 	bool irq_requested;
+	bool fault;			/* the firmware reported a fault */
 	struct mutex lock;		/* firmware state and mailbox */
 	struct delayed_work rx_work;
 	struct completion boot_done;
@@ -165,6 +168,13 @@ static void abox_rx_work(struct work_struct *work)
 			 readl(abox->sram + ABOX_IPC_RX_OFFSET + 20));
 		if (ipcid == ABOX_IPC_SYSTEM && type == ABOX_SYS_BOOT_DONE)
 			complete(&abox->boot_done);
+		if (ipcid == ABOX_IPC_SYSTEM && type == ABOX_SYS_REPORT_FAULT) {
+			WRITE_ONCE(abox->fault, true);
+			dev_err(abox->dev, "the firmware reports a fault (%#x, %#x, %#x)\n",
+				readl(abox->sram + ABOX_IPC_RX_OFFSET + 12),
+				readl(abox->sram + ABOX_IPC_RX_OFFSET + 16),
+				readl(abox->sram + ABOX_IPC_RX_OFFSET + 20));
+		}
 		writel(0, abox->sram + ABOX_IPC_RX_ACK_OFFSET);
 	}
 	schedule_delayed_work(&abox->rx_work, msecs_to_jiffies(5));
@@ -185,6 +195,8 @@ static int abox_ipc(struct abox *abox, u32 ipcid, u32 task, u32 type,
 
 	end = jiffies + msecs_to_jiffies(1000);
 	while (readl(abox->sram + ABOX_IPC_TX_ACK_OFFSET)) {
+		if (READ_ONCE(abox->fault))
+			return -EIO;
 		if (time_after(jiffies, end)) {
 			dev_err(abox->dev, "no ack for message %u/%#x\n", ipcid, type);
 			return -ETIMEDOUT;
@@ -335,13 +347,14 @@ static irqreturn_t abox_irq(int irq, void *data)
 	return ret;
 }
 
-static int abox_load_and_start(struct abox *abox)
+static int abox_try_start(struct abox *abox)
 {
 	const struct firmware *fw_sram, *fw_dram;
 	struct device *dev = abox->dev;
 	unsigned int i, status = 0;
 	int ret;
 
+	WRITE_ONCE(abox->fault, false);
 	ret = request_firmware(&fw_sram, "calliope_sram.bin", dev);
 	if (ret)
 		return ret;
@@ -431,6 +444,26 @@ static int abox_load_and_start(struct abox *abox)
 	return ret;
 }
 
+/*
+ * The firmware sometimes reports a fault soon after it starts (an undefined
+ * exception in the code it has just been loaded with); a restart gets over it.
+ */
+static int abox_load_and_start(struct abox *abox)
+{
+	int i, ret = -EIO;
+
+	for (i = 0; i < ABOX_START_TRIES; i++) {
+		ret = abox_try_start(abox);
+		if (!ret)
+			return 0;
+		dev_warn(abox->dev, "firmware start failed (%d), try %d of %d\n", ret, i + 1,
+			 ABOX_START_TRIES);
+		msleep(500);
+	}
+
+	return ret;
+}
+
 static void abox_rdma_regs(struct abox *abox, bool on)
 {
