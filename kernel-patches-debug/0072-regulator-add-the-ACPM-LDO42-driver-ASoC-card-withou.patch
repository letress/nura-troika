diff --git a/drivers/regulator/exynos-acpm-ldo.c b/drivers/regulator/exynos-acpm-ldo.c
new file mode 100644
index 0000000..7caf8da
--- /dev/null
+++ b/drivers/regulator/exynos-acpm-ldo.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * One LDO of the Samsung S2MPU09 PMIC of the Exynos9610, switched through the
+ * ACPM firmware.
+ *
+ * The firmware owns the I2C bus of the PMIC; the kernel asks it to read and
+ * to update a register (FUNC_READ and FUNC_UPDATE of the vendor acpm_mfd.h).
+ * The driver only touches the enable bits of one control register and does
+ * not set the voltage: before it switches the LDO on it checks that the rest
+ * of the register still holds the voltage code the bootloader left, which the
+ * device tree names. There is no disable operation; the regulator is meant to
+ * be always on, as the vendor device tree has it, because other devices may
+ * share the rail.
+ */
+
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+struct acpm_ldo {
+	struct device *dev;
+	struct acpm_handle *acpm;
+	u32 chan;		/* ACPM IPC channel of the PMIC */
+	u32 type;		/* PMIC address as the firmware numbers it */
+	u32 reg;		/* control register */
+	u32 enable_mask;	/* enable bits of the control register */
+	u32 voltage_code;	/* the other bits: the voltage left by the bootloader */
+};
+
+static int acpm_ldo_read(struct acpm_ldo *ldo, u8 *val)
+{
+	return ldo->acpm->ops->pmic.read_reg(ldo->acpm, ldo->chan, ldo->type,
+					     ldo->reg, 0, val);
+}
+
+static int acpm_ldo_is_enabled(struct regulator_dev *rdev)
+{
+	struct acpm_ldo *ldo = rdev_get_drvdata(rdev);
+	u8 val;
+	int ret;
+
+	ret = acpm_ldo_read(ldo, &val);
+	if (ret)
+		return ret;
+
+	return (val & ldo->enable_mask) == ldo->enable_mask;
+}
+
+static int acpm_ldo_enable(struct regulator_dev *rdev)
+{
+	struct acpm_ldo *ldo = rdev_get_drvdata(rdev);
+	u8 val;
+	int ret;
+
+	ret = acpm_ldo_read(ldo, &val);
+	if (ret)
+		return ret;
+	if ((val & ~ldo->enable_mask) != ldo->voltage_code) {
+		dev_err(ldo->dev, "voltage code %#x differs from the expected %#x, not enabling\n",
+			val & ~ldo->enable_mask, ldo->voltage_code);
+		return -EINVAL;
+	}
+
+	if ((val & ldo->enable_mask) == ldo->enable_mask)
+		return 0;
+
+	dev_info(ldo->dev, "switching on (register %#x)\n", val);
+
+	return ldo->acpm->ops->pmic.update_reg(ldo->acpm, ldo->chan, ldo->type,
+					       ldo->reg, 0, ldo->enable_mask,
+					       ldo->enable_mask);
+}
+
+static const struct regulator_ops acpm_ldo_ops = {
+	.enable		= acpm_ldo_enable,
+	.is_enabled	= acpm_ldo_is_enabled,
+	.list_voltage	= regulator_list_voltage_linear,
+};
+
+static int acpm_ldo_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct regulator_config config = { };
+	struct regulator_desc *desc;
+	struct regulator_init_data *init;
+	struct regulator_dev *rdev;
+	struct acpm_ldo *ldo;
+	u32 uv;
+	int ret;
+
+	ldo = devm_kzalloc(dev, sizeof(*ldo), GFP_KERNEL);
+	desc = devm_kzalloc(dev, sizeof(*desc), GFP_KERNEL);
+	if (!ldo || !desc)
+		return -ENOMEM;
+	ldo->dev = dev;
+
+	ldo->acpm = devm_acpm_get_by_phandle(dev);
+	if (IS_ERR(ldo->acpm))
+		return dev_err_probe(dev, PTR_ERR(ldo->acpm), "no ACPM handle\n");
+
+	ret = of_property_read_u32(np, "samsung,acpm-channel", &ldo->chan);
+	ret |= of_property_read_u32(np, "samsung,pmic-type", &ldo->type);
+	ret |= of_property_read_u32(np, "samsung,register", &ldo->reg);
+	ret |= of_property_read_u32(np, "samsung,enable-mask", &ldo->enable_mask);
+	ret |= of_property_read_u32(np, "samsung,voltage-code", &ldo->voltage_code);
+	ret |= of_property_read_u32(np, "regulator-min-microvolt", &uv);
+	if (ret)
+		return dev_err_probe(dev, -EINVAL, "missing properties\n");
+
+	/* a fixed voltage: the driver does not change it */
+	desc->name = dev_name(dev);
+	desc->type = REGULATOR_VOLTAGE;
+	desc->owner = THIS_MODULE;
+	desc->ops = &acpm_ldo_ops;
+	desc->n_voltages = 1;
+	desc->min_uV = uv;
+
+	init = of_get_regulator_init_data(dev, np, desc);
+	if (!init)
+		return -EINVAL;
+
+	config.dev = dev;
+	config.init_data = init;
+	config.driver_data = ldo;
+	config.of_node = np;
+	rdev = devm_regulator_register(dev, desc, &config);
+	if (IS_ERR(rdev))
+		return dev_err_probe(dev, PTR_ERR(rdev), "cannot register the regulator\n");
+
+	return 0;
+}
+
+static const struct of_device_id acpm_ldo_of_match[] = {
+	{ .compatible = "samsung,exynos9610-acpm-ldo" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, acpm_ldo_of_match);
+
+static struct platform_driver acpm_ldo_driver = {
+	.probe = acpm_ldo_probe,
+	.driver = {
+		.name = "exynos9610-acpm-ldo",
+		.of_match_table = acpm_ldo_of_match,
+	},
+};
+module_platform_driver(acpm_ldo_driver);
+
+MODULE_DESCRIPTION("LDO of the Exynos9610 PMIC switched through the ACPM firmware");
+MODULE_LICENSE("GPL");
