From c09bda38d1154ab11bf00cd0f9735a58789306ea Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:01:06 +0100
Subject: [PATCH 16/29] DEBUG: abox-sysmmu-test: debugfs ack takes the firmware
 messages one by one

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/iommu/abox-sysmmu-test.c | 43 +++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/abox-sysmmu-test.c b/drivers/iommu/abox-sysmmu-test.c
index 033bc71..9503fd0 100644
--- a/drivers/iommu/abox-sysmmu-test.c
+++ b/drivers/iommu/abox-sysmmu-test.c
@@ -13,6 +13,7 @@
 #include <linux/atomic.h>
 #include <linux/gfp.h>
 #include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/firmware.h>
 #include <linux/io.h>
 #include <linux/iommu.h>
@@ -45,6 +46,8 @@
 #define ABOX_SRAM_SIZE		0x35000UL
 #define ABOX_IPC_TX_OFFSET	0x22000		/* ipc_tx_offset */
 #define ABOX_IPC_RX_OFFSET	0x22300		/* ipc_rx_offset */
+#define ABOX_IPC_TX_ACK_OFFSET	0x222FC		/* ipc_tx_ack_offset */
+#define ABOX_IPC_RX_ACK_OFFSET	0x225FC		/* ipc_rx_ack_offset */
 #define ABOX_DRAM_FW_SIZE	(SZ_8M + SZ_4M)	/* DRAM_FIRMWARE_SIZE */
 #define ABOX_PMU_CPU_CONFIGURATION	0x2520	/* ABOX_CPU_CONFIGURATION */
 #define ABOX_PMU_CPU_STATUS		0x2524	/* ABOX_CPU_STATUS */
@@ -152,7 +155,9 @@ static void abox_fw_dump(struct seq_file *m)
 	seq_puts(m, "\nipc rx:");
 	for (i = 0; i < 8; i++)
 		seq_printf(m, " %08x", readl(abox_fw.sram + ABOX_IPC_RX_OFFSET + 4 * i));
-	seq_puts(m, "\n");
+	seq_printf(m, "\nack tx %u rx %u\n",
+		   readl(abox_fw.sram + ABOX_IPC_TX_ACK_OFFSET),
+		   readl(abox_fw.sram + ABOX_IPC_RX_ACK_OFFSET));
 }
 
 static int abox_fw_status_show(struct seq_file *m, void *unused)
@@ -251,6 +256,41 @@ static int abox_fw_stop_set(void *data, u64 val)
 }
 DEFINE_DEBUGFS_ATTRIBUTE(abox_fw_stop_fops, NULL, abox_fw_stop_set, "%llu\n");
 
+/*
+ * Take the messages of the firmware one by one: log the one in the rx slot,
+ * clear its ack like the vendor interrupt handler does (only SRAM, no GIC)
+ * and wait a moment for the next one. Nothing is sent to the firmware.
+ */
+static int abox_fw_ack_set(void *data, u64 val)
+{
+	unsigned int round, i, w[8];
+
+	if (val != 1 || !abox_fw.started)
+		return -EINVAL;
+
+	for (round = 0; round < 16; round++) {
+		for (i = 0; i < 8; i++)
+			w[i] = readl(abox_fw.sram + ABOX_IPC_RX_OFFSET + 4 * i);
+		dev_info(abox_fw.dev,
+			 "ABOXFW: rx ack %u msg %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			 readl(abox_fw.sram + ABOX_IPC_RX_ACK_OFFSET),
+			 w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		if (!readl(abox_fw.sram + ABOX_IPC_RX_ACK_OFFSET))
+			break;
+		writel(0, abox_fw.sram + ABOX_IPC_RX_ACK_OFFSET);
+		for (i = 0; i < 50 && !readl(abox_fw.sram + ABOX_IPC_RX_ACK_OFFSET); i++)
+			msleep(10);
+		if (!readl(abox_fw.sram + ABOX_IPC_RX_ACK_OFFSET)) {
+			dev_info(abox_fw.dev, "ABOXFW: no further message after %u\n",
+				 round + 1);
+			break;
+		}
+	}
+
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(abox_fw_ack_fops, NULL, abox_fw_ack_set, "%llu\n");
+
 static int abox_test_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -335,6 +375,7 @@ static int abox_test_probe(struct platform_device *pdev)
 		debugfs_create_file("status", 0400, dir, NULL, &abox_fw_status_fops);
 		debugfs_create_file("load", 0200, dir, NULL, &abox_fw_load_fops);
 		debugfs_create_file("start", 0200, dir, NULL, &abox_fw_start_fops);
+		debugfs_create_file("ack", 0200, dir, NULL, &abox_fw_ack_fops);
 		debugfs_create_file("stop", 0200, dir, NULL, &abox_fw_stop_fops);
 		dev_info(dev, "ABOXFW: debugfs files ready, nothing done\n");
 	}
