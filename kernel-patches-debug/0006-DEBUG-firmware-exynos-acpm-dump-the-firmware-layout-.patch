From e1ec2b1ecc98aace64c5dd60954fe5da4bfc049f Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:48:24 +0100
Subject: [PATCH 6/7] DEBUG: firmware: exynos-acpm: dump the firmware layout
 and the plugins

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/firmware/samsung/exynos-acpm.c | 120 +++++++++++++++++++++++++
 1 file changed, 120 insertions(+)

diff --git a/drivers/firmware/samsung/exynos-acpm.c b/drivers/firmware/samsung/exynos-acpm.c
index bb0ce55..596535b 100644
--- a/drivers/firmware/samsung/exynos-acpm.c
+++ b/drivers/firmware/samsung/exynos-acpm.c
@@ -878,6 +878,124 @@ static void acpm_plugins_attach(struct acpm_info *acpm,
 	}
 }
 
+/*
+ * DEBUG: report what the firmware offers and which plugins are attached.
+ * Nothing is sent to the firmware.
+ */
+#define ACPMDBG_FVMAP_OFFSET	0x6000	/* fvmap_offset of the vendor acpm node */
+
+/* struct fvmap_header of the vendor cal-if/fvmap.h */
+struct acpmdbg_fvmap_header {
+	u8 dvfs_type;
+	u8 num_of_lv;
+	u8 num_of_members;
+	u8 num_of_pll;
+	u8 num_of_mux;
+	u8 num_of_div;
+	u16 gearratio;
+	u8 init_lv;
+	u8 num_of_gate;
+	u8 reserved[2];
+	u16 block_addr[3];
+	u16 o_members;
+	u16 o_ratevolt;
+	u16 o_tables;
+};
+
+static void acpmdbg_dump_fvmap(struct acpm_info *acpm, u32 base)
+{
+	static const char * const names[] = {
+		"MIF", "INT", "CPUCL0", "CPUCL1", "G3D",
+		"INTCAM", "CAM", "DISP", "AUD", "CP",
+	};
+	struct device *dev = acpm->dev;
+	void __iomem *fvmap;
+	int i, j;
+
+	if (base + ARRAY_SIZE(names) * sizeof(struct acpmdbg_fvmap_header) >
+	    acpm->sram_size) {
+		dev_info(dev, "ACPMDBG fvmap at %#x is outside of the SRAM\n", base);
+		return;
+	}
+	fvmap = acpm->sram_base + base;
+	dev_info(dev, "ACPMDBG fvmap at SRAM + %#x\n", base);
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		struct acpmdbg_fvmap_header h;
+
+		memcpy_fromio(&h, fvmap + i * sizeof(h), sizeof(h));
+		dev_info(dev, "ACPMDBG fvmap %s: type %u levels %u init_lv %u pll %u o_ratevolt %#x\n",
+			 names[i], h.dvfs_type, h.num_of_lv, h.init_lv,
+			 h.num_of_pll, h.o_ratevolt);
+		if (!h.num_of_lv || h.num_of_lv > 40 || (h.o_ratevolt & 3) ||
+		    base + h.o_ratevolt + h.num_of_lv * 8 > acpm->sram_size) {
+			dev_info(dev, "ACPMDBG   %s: table skipped\n", names[i]);
+			continue;
+		}
+		for (j = 0; j < h.num_of_lv; j++) {
+			u32 rate = readl(fvmap + h.o_ratevolt + j * 8);
+			u32 volt = readl(fvmap + h.o_ratevolt + j * 8 + 4);
+
+			dev_info(dev, "ACPMDBG   %s lv %2d: %7u kHz %7u uV\n",
+				 names[i], j, rate, volt);
+		}
+	}
+}
+
+static void acpmdbg_dump(struct acpm_info *acpm)
+{
+	struct acpm_plugin_shmem __iomem *plugins;
+	struct acpm_chan_shmem __iomem *chans;
+	struct device *dev = acpm->dev;
+	u32 offset, num_plugins;
+	int i, j;
+
+	offset = readl(&acpm->shmem->plugins);
+	num_plugins = readl(&acpm->shmem->num_plugins);
+	dev_info(dev, "ACPMDBG framework: plugins %u at %#x, channels %u at %#x\n",
+		 num_plugins, offset, acpm->num_chans,
+		 readl(&acpm->shmem->chans));
+
+	chans = acpm->sram_base + readl(&acpm->shmem->chans);
+	for (i = 0; i < acpm->num_chans; i++) {
+		struct acpm_chan *achan = &acpm->chans[i];
+
+		/* reserved[] of the channel is field, owner, type */
+		dev_info(dev, "ACPMDBG chan %d: id %u owner %d type %u poll %d mlen %u qlen %u\n",
+			 i, achan->id, (int)readl(&chans[i].reserved[1]),
+			 readl(&chans[i].reserved[2]), achan->poll_completion,
+			 achan->mlen, achan->qlen);
+	}
+
+	if (num_plugins > 16 ||
+	    offset + num_plugins * sizeof(*plugins) > acpm->sram_size) {
+		dev_info(dev, "ACPMDBG plugin table looks wrong, skipped\n");
+		return;
+	}
+
+	plugins = acpm->sram_base + offset;
+	for (i = 0; i < num_plugins; i++) {
+		u32 fw_name = readl(&plugins[i].fw_name);
+		u32 base = readl(&plugins[i].base_addr);
+		u8 attached = readb(&plugins[i].is_attached);
+		char name[ACPM_PLUGIN_NAME_LEN] = "";
+
+		if (fw_name && fw_name + sizeof(name) <= acpm->sram_size) {
+			memcpy_fromio(name, acpm->sram_base + fw_name,
+				      sizeof(name) - 1);
+			for (j = 0; name[j]; j++)
+				if (name[j] < 0x20 || name[j] > 0x7e)
+					name[j] = '?';
+		}
+		dev_info(dev, "ACPMDBG plugin %d: id %u base %#x size %#x attached %u stay %u fw '%s'\n",
+			 i, readl(&plugins[i].id), base, readl(&plugins[i].size),
+			 attached, readb(&plugins[i].stay_attached), name);
+
+		if (attached && (strstr(name, "DVFS") || strstr(name, "dvfs")))
+			acpmdbg_dump_fvmap(acpm, (base & ~1U) + ACPMDBG_FVMAP_OFFSET);
+	}
+}
+
 static int acpm_probe(struct platform_device *pdev)
 {
 	const struct acpm_match_data *match_data;
@@ -922,6 +1040,8 @@ static int acpm_probe(struct platform_device *pdev)
 	acpm->handle.ops = &exynos_acpm_driver_ops;
 
 	acpm_plugins_attach(acpm, match_data);
+	if (match_data->plugins)
+		acpmdbg_dump(acpm);
 
 	platform_set_drvdata(pdev, acpm);
 
-- 
