From 411239e20d55e18db95667cb047b01c1b09278d0 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:28:55 +0100
Subject: [PATCH 47/63] DEBUG: CS47L35 audio codec on SPI9

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../boot/dts/exynos/exynos9610-troika.dts     | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
index beb913d..ebb4945 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
@@ -401,3 +401,28 @@ controller-data {
 		};
 	};
 };
+
+/*
+ * Audio codec CS47L35 (Madera) on SPI9, values from the live device tree of
+ * the stock system. Its supplies are on from boot (LDO42, V_SYS) and not
+ * described. No clock is described yet: the vendor system feeds it a 26 MHz
+ * reference from xclkout.
+ */
+&spi_9 {
+	pinctrl-0 = <&spi9_bus &spi9_cs_func>;
+	status = "okay";
+
+	audio_codec: codec@0 {
+		compatible = "cirrus,cs47l35";
+		reg = <0>;
+		spi-max-frequency = <11000000>;
+		interrupt-parent = <&gpa0>;
+		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		reset-gpios = <&gpg3 2 GPIO_ACTIVE_HIGH>;
+		#sound-dai-cells = <1>;
+	};
+};
